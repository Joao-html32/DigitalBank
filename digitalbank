public class DigitalBank {
  public static void main(String[] args) {
    ContaBancaria objeto = new ContaBancaria("1234-5", "JoaoVitor", 100.00);
    ContaBancaria contaAmigo = new ContaBancaria("5432-1", "CarlosSilva", 50.00);
    System.out.println("Conta criada com sucesso no Itaú!");
    System.out.println("=== ITAÚ DIGITAL ===");
    System.out.println("Saldo inicial: " + objeto.getSaldo());
     System.out.println("Saldo inicial Amigo: R$ " + contaAmigo.getSaldo());

    System.out.println("\n[Tentativa] Realizando Pix de R$ 120.00 para o amigo...");
    objeto.transferirPix(120.00, contaAmigo);
    
    System.out.println("\n=== SALDOS ATUALIZADOS ===");
    System.out.println("Saldo atual João: R$ " + objeto.getSaldo());
    System.out.println("Saldo atual Amigo: R$ " + contaAmigo.getSaldo());



    System.out.println("\n[Tentativa 1] Sacando R$ 150.00...");
    objeto.sacar(150.00);
    
    System.out.println("\n[Tentativa 2] Depositando R$ 50.00...");
    objeto.depositar(50.00);
    System.out.println("Saldo atual: R$ " + objeto.getSaldo());
    
    System.out.println("\n[Tentativa 3] Sacando R$ 150.00...");
    objeto.sacar(150.00);
    System.out.println("Saldo atual: R$ " + objeto.getSaldo());
  }
}
